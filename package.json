{
  "name": "react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "dev:full": "concurrently \"npm:dev\" \"npm:dev:api\"",
    "build": "vite build && node scripts/generate-seo-assets.mjs",
    "seo:generate": "node scripts/generate-seo-assets.mjs",
    "start": "node server/index.js",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit --project tsconfig.app.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run type-check && npm run lint && npm run test && npm run build",
    "instagram:refresh": "node scripts/seed-instagram-permalinks.mjs && node scripts/build-instagram-bundled.mjs",
    "showcase:videos": "node scripts/build-showcase-videos.mjs",
    "showcase:webp": "node scripts/convert-showcase-webp.mjs",
    "google-reviews:refresh": "node scripts/build-google-reviews-bundled.mjs",
    "pages:webp": "node scripts/convert-page-images-webp.mjs",
    "blog:images": "node scripts/build-blog-images.mjs",
    "deploy:push": "git push papyon main"
  },
  "dependencies": {
    "@aduptive/instagram-scraper": "^1.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.0",
    "google-maps-review-scraper": "^2.0.0",
    "helmet": "^8.1.0",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.469.0",
    "nodemailer": "^8.0.7",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-i18next": "^15.6.0",
    "react-router-dom": "^7.6.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jiti": "^2.6.1",
    "postcss": "^8.5.6",
    "source-map": "^0.7.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "unplugin-auto-import": "^19.3.0",
    "vite": "^8.0.1"
  }
}
